generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum AlertType {
  WEATHER
  AQI
  HEALTH
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avatar String?
  phone  String?
  status Boolean @default(true)

  // Email verification
  isVerified       Boolean  @default(false)
  emailVerifyToken String?

  // Password reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  refreshTokens  RefreshToken[]
  settings       UserSettings?
  favorites      FavoriteLocation[]
  notifications  Notification[]
  chatHistories  ChatHistory[]
  predictions    PredictionHistory[]
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON field for flexible settings: { "emailAlerts": true, "pushAlerts": true, "aqiThreshold": 100 }
  preferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Location {
  id        String  @id @default(uuid())
  name      String
  province  String?
  district  String?
  ward      String?
  latitude  Float
  longitude Float
  timezone  String?
  country   String?

  favorites      FavoriteLocation[]
  weather        WeatherData[]
  airQuality     AirQualityData[]
  forecasts      ForecastData[]
  aqiForecasts   AqiForecast[]
  predictions    PredictionHistory[]
  notifications  Notification[]

  @@index([latitude, longitude])
}

model FavoriteLocation {
  id         String @id @default(uuid())
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, locationId])
}

model WeatherData {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  temperature   Float?
  feelsLike     Float?
  humidity      Float?
  pressure      Float?

  windSpeed     Float?
  windDirection Float?

  visibility    Float?
  uvIndex       Float?
  rain          Float?

  condition     String?
  icon          String?

  timestamp DateTime @default(now())

  @@index([locationId, timestamp])
}

model AirQualityData {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  aqi  Int
  pm25 Float?
  pm10 Float?
  co   Float?
  o3   Float?
  no2  Float?
  so2  Float?

  timestamp DateTime @default(now())

  @@index([locationId, timestamp])
}

model ForecastData {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  forecastDate DateTime
  temperature  Float?
  aqi          Int?
  condition    String?

  createdAt DateTime @default(now())

  @@index([locationId, forecastDate])
}

model HealthRecommendation {
  id          String   @id @default(uuid())
  minAqi      Int
  maxAqi      Int
  targetGroup String   @default("GENERAL") // GENERAL, SENSITIVE, CHILDREN, ELDERLY, RESPIRATORY
  title       String
  description String
  actions     Json?    // Danh sách hành động khuyến nghị: ["Đeo khẩu trang N95", "Đóng cửa sổ", "Bật máy lọc không khí"]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([minAqi, maxAqi])
  @@index([targetGroup])
}

model Notification {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)

  type       AlertType
  title      String
  message    String
  metadata   Json?              // Dữ liệu mở rộng (aqi, pm25, coordinates, deep link)
  status     NotificationStatus @default(UNREAD)

  createdAt  DateTime           @default(now())

  @@index([userId, status])
  @@index([locationId])
}

model PredictionHistory {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  prompt     String
  response   String
  context    Json?     // AQI + weather data tại thời điểm hỏi

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([locationId])
}

model SystemLog {
  id      String   @id @default(uuid())
  level   LogLevel // INFO, WARN, ERROR
  context String   // e.g. "Scheduler", "API"
  message String
  meta    Json?    // Additional error traces or details

  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

// -----------------------------------------------------------------------------
// AI / PREDICTION
// -----------------------------------------------------------------------------

model AqiForecast {
  id            String   @id @default(uuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  forecastHour  Int      // Giờ thứ mấy trong tương lai (1, 2, ..., 48)
  predictedAqi  Int      // AQI dự đoán từ model LSTM/XGBoost
  predictedPm25 Float?   // PM2.5 dự đoán
  temperature   Float?   // Nhiệt độ dự báo kèm theo (°C)
  humidity      Float?   // Độ ẩm dự báo kèm theo (%)
  actualAqi     Int?     // AQI thực tế (cập nhật sau để đánh giá model)

  confidence    Float?   // Độ tin cậy (0-1)
  modelVersion  String?  // Version model ("v1.0", "v1.1"...)

  predictedAt   DateTime @default(now()) // Thời điểm chạy dự đoán
  targetTime    DateTime // Thời điểm được dự đoán

  @@index([locationId, targetTime])
  @@index([locationId, predictedAt])
}

model ChatHistory {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message  String // Câu hỏi của user
  response String // Trả lời từ Gemini AI
  context  Json?  // Snapshot dữ liệu AQI + weather tại thời điểm hỏi

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
